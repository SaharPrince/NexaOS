# Debian's maintained LXQt desktop task provides the X11 session, display
# manager, panel, file manager, settings tools, and hardware input/video stack.
# APT recommendations are disabled by the build config to avoid pulling in
# optional office suites and other nonessential recommended applications.
task-lxqt-desktop

# NexaOS's small Qt 6 welcome hub (uses the desktop's existing Qt stack).
python3
python3-pyqt6

# Network management UI for the live desktop.
network-manager
network-manager-gnome

# Common firmware packages; hardware coverage still requires device testing.
firmware-linux-free
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek

# live-config recommends these packages; recommendations are disabled globally.
# user-setup creates the live user account used by console and desktop autologin.
# sudo allows the live user to perform permitted shutdown/reboot actions.
user-setup
sudo
